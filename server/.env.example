# PostgreSQL connection string (required in production; use a different database and password than local)
DATABASE_URL=postgres://postgres:your_password@localhost:5432/silky

# Server
PORT=3001
# REQUIRED, one of: production | development | test. The server refuses to start without a valid value, so a host
# that forgets it cannot silently run with development settings. Use "production" on the live site.
NODE_ENV=development
# Development only: the "forgot password" answer includes the reset token (shown on the page) when this is true and
# no SMTP user is set. Always ignored in production.
EXPOSE_RESET_TOKEN=true
# Content-Security-Policy for the pages: report-only (default, blocks nothing; the browser console lists what a strict policy
# would refuse), enforce (blocks), or off. Set enforce on the live site only after browsing it with no report.
# CSP_MODE=report-only
# Database pool (defaults = what the app always used). Keep DB_POOL_MAX below the database plan's connection limit.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=0
# One log line per request (method, path, status, duration; never the query string, body or IP). On by default in
# production; LOG_REQUESTS=false turns it off, LOG_REQUESTS=true turns it on elsewhere.
# LOG_REQUESTS=true
# NEVER set this on a live shop. One old start-up migration deletes ALL orders when orders.governorate_id is missing; it
# now refuses to run while orders exist unless this is "yes".
# ALLOW_ORDER_RESET=yes
# Number of reverse proxies in front of the server (for example 1 on most hosts: Render, Railway, nginx). Needed in
# production so the rate limiters see each visitor's address and not the proxy's. Leave unset locally.
# TRUST_PROXY=1
# CORS allowed origins (comma-separated list of exact origins)
# In development, defaults to http://localhost:4321 if not set.
# In production, this variable is REQUIRED.
# Locally: the Astro storefront and admin panel (both http://localhost:4321).
# In production: https://silky.tn only (the admin is https://silky.tn/admin, same origin).
CORS_ALLOWED_ORIGINS=http://localhost:4321

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin account (seeded on first run)
ADMIN_EMAIL=admin@silky.tn
# Production refuses to start unless this is set, at least 10 characters and not a placeholder.
ADMIN_PASSWORD=change-me

# Guest session cookie name
GUEST_SESSION_COOKIE_NAME=silky_guest_session

# Password reset token expiry (hours)
PASSWORD_RESET_EXPIRES_HOURS=1

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# SMTP server hostname.
# Resend (HTTPS API, https://resend.com): set RESEND_API_KEY and e-mail goes through it instead of SMTP. Use it on hosts that
# block the SMTP ports (Render's free plan does). EMAIL_FROM must then be an address on a domain verified in Resend (the
# domain's DNS records), e.g. Silky <no-reply@silky.tn>; before that Resend only sends from onboarding@resend.dev to your own
# address. Free plan: 3000 e-mails a month, 100 a day. Never commit the key.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_API_URL=https://api.resend.com   (only for tests; leave unset)
# Common SMTP providers: smtp.gmail.com | smtp-relay.brevo.com | smtp.mailgun.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to true only when using port 465 (implicit TLS / SSL); leave false for STARTTLS
SMTP_SECURE=false
# SMTP credentials — for Gmail use an App Password, not your account password.
# Leave both blank in development to automatically use Ethereal (captures emails locally).
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Friendly sender address shown in the From header
EMAIL_FROM=Silky <no-reply@yourdomain.com>
# Public base URL of the frontend application (used to build the reset link in emails)
APP_URL=https://yourdomain.com

# GOODEX delivery (leave blank until issued; never commit real values).
# Until GOODEX_API_TOKEN and GOODEX_USER_ID are set, confirming an order still works but its
# parcel is recorded as failed ("Configuration GOODEX incomplète"); retry it from Admin Orders
# once configured. Until GOODEX_WEBHOOK_SECRET is set, POST /api/webhooks/goodex answers 503.
# Obtained FROM GOODEX: API token and sender id (user_id) for our account.
GOODEX_API_TOKEN=
GOODEX_USER_ID=
# Chosen BY US (generate a long random string) and entered in GOODEX's webhook settings so it
# sends "Authorization: Bearer <secret>" to https://<our-domain>/api/webhooks/goodex.
# Must differ from the API token. Generated (or typed) in the GOODEX customer area, webhook page
# ("Jeton secret"), next to our public https URL; paste the same value here.
GOODEX_WEBHOOK_SECRET=
# Real GOODEX calls are OFF by default. Set to true ONLY on the environment that should talk to
# the real provider. Even then they stay blocked when NODE_ENV=test or the database name
# contains "test". A loopback GOODEX_BASE_URL (local mock servers) is always allowed.
# GOODEX_ENABLE_LIVE=true
# Optional overrides
# GOODEX_BASE_URL=https://transport.goodex.tn  
# GOODEX_TIMEOUT_MS=10000
# Background status reconciliation: the server asks GOODEX (read-only) for the status of existing
# parcels. OFF by default: set the minutes between runs (e.g. 15) to enable it; 0 or unset keeps
# it off. Enable it on ONE server instance only.
# GOODEX_POLL_INTERVAL_MINUTES=15
# Parcels checked per run, parallel requests, and the age (days) after which a parcel is dropped.
# GOODEX_POLL_BATCH_SIZE=50
# GOODEX_POLL_CONCURRENCY=2
# GOODEX_POLL_MAX_AGE_DAYS=60

# Folder where uploaded photos and videos are stored and served from (/uploads). Default: ./server/uploads.
# Set it when the host keeps uploads on a separate persistent disk. Resized copies and originals live together.
# UPLOADS_DIR=

# Where uploaded photos and videos are stored.
# STORAGE_DRIVER=disk (default): the folder above, served by this API at /uploads (local development, tests).
# STORAGE_DRIVER=r2: a Cloudflare R2 bucket; the API then serves no /uploads and the public address below is used.
# Choosing r2 without the four R2_ variables stops the server at start.
# STORAGE_DRIVER=disk
# R2_ACCOUNT_ID=          (Cloudflare dashboard > R2 > Overview, "Account ID")
# R2_ACCESS_KEY_ID=       (an R2 API token limited to the bucket, Object Read & Write)
# R2_SECRET_ACCESS_KEY=   (shown once when the token is created; never commit it)
# R2_BUCKET=silky-media
# Public address of the bucket (custom domain such as https://media.silky.tn, or the bucket's r2.dev address while
# testing). The storefront's PUBLIC_MEDIA_URL must be the same address. No trailing slash.
# MEDIA_PUBLIC_URL=
