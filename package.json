{

  "name": "silky-app",

  "private": true,

  "version": "1.0.0",

  "type": "module",
  "engines": {
    "node": ">=20"
  },

  "scripts": {

    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",

    "dev:client": "vite",

    "dev:server": "node server/index.js",

    "dev:storefront": "npm run dev --prefix storefront",

    "build": "node scripts/build.mjs",

    "preview": "vite preview",

    "start": "node server/index.js",
    "start:server": "node server/index.js",

    "db:generate": "drizzle-kit generate",

    "db:push": "drizzle-kit push",

    "db:check": "drizzle-kit check",

    "db:schema": "node server/db/init-db.js",
    "db:init": "node server/db/init-db.js",
    "db:export-schema": "node server/db/export-schema.js",
    "admin:create": "node server/db/create-admin.js",
    "preflight": "node server/scripts/preflight.js",

    "db:seed": "node server/db/seed.js",

    "test": "node server/scripts/verify-phase3.js"

  },

  "dependencies": {

    "bcrypt": "^6.0.0",

    "compression": "^1.8.2",

    "cookie-parser": "^1.4.7",

    "cors": "^2.8.5",

    "dotenv": "^17.4.2",

    "drizzle-kit": "^0.31.10",

    "drizzle-orm": "^0.45.2",

    "express": "^4.21.2",

    "jsonwebtoken": "^9.0.3",

    "jspdf": "^4.2.1",

    "multer": "^1.4.5-lts.1",

    "nodemailer": "^10.3.1",

    "pg": "^8.23.0",

    "react": "^19.1.0",

    "react-dom": "^19.1.0",

    "react-router-dom": "^7.6.0",

    "sharp": "^0.35.5"

  },

  "devDependencies": {

    "@vitejs/plugin-react": "^4.5.0",

    "concurrently": "^9.1.2",

    "vite": "^6.3.0"

  }

}

