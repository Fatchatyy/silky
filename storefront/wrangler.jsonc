{
  "name": "silky-storefront",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // The API the Worker itself calls at run time (the admin shell and password-reset pages).
  // `astro dev` and the tests read API_URL from their own environment.
  "vars": {
    "API_URL": "https://api.silky.tn"
  }
}
