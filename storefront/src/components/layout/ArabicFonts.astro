---
// Cairo, the Arabic pages' font, served from this site (fontsource): no request to Google, no render-blocking stylesheet.
// Rendered only on /ar pages. (Astro bundles CSS by import, so the rules may also reach French pages' CSS; harmless: a browser
// downloads a font file only when text uses it, and no French text uses Cairo.)
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-500.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/latin-400.css';
import '@fontsource/cairo/latin-500.css';
import '@fontsource/cairo/latin-600.css';
import '@fontsource/cairo/latin-700.css';
---
