---
// Server-rendered product card (same markup and classes as ProductCard.jsx): a real <a href>, name and price in HTML.
import { productCustomAlt, productName } from '../../shared/productText.js';
import { localizePath } from '../../shared/locales.js';
import { productPath } from '../../shared/urls.js';
import { mediaVariant } from '../lib/media.ts';
import ProductPriceView from './ProductPriceView.astro';
import ProductBadgesView from './ProductBadgesView.astro';
import type { Locale } from '../lib/seo/types.ts';

// `heading`: the level of the card's name. h3 under a section's h2 (home); h2 straight under the page's h1 (collection page).
const { product, locale, fallbackImage = '', priority = false, first = false, heading = 'h3' } = Astro.props as { product: any; locale: Locale; fallbackImage?: string; priority?: boolean; first?: boolean; heading?: 'h2' | 'h3' };
const Heading = heading;
const name = productName(product, locale);
const alt = productCustomAlt(product, locale) || name;
const image = product.collectionImage || product.mainImage || fallbackImage;
---
<div class="product_card">
  <a href={localizePath(productPath(product), locale)} class="product_card_link">
    <div class="product_image_container">
      <ProductBadgesView product={product} locale={locale} />
      <img src={mediaVariant(image, 'card')} alt={alt} class="product_img" loading={priority ? 'eager' : 'lazy'} fetchpriority={first ? 'high' : undefined} decoding="async" />
    </div>
    <div class="product_info">
      <Heading class="product_name">{name}</Heading>
      <p class="product_price">
        <ProductPriceView product={product} locale={locale} size="small" />
      </p>
    </div>
  </a>
</div>
