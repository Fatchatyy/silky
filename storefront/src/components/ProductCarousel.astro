---
// The home page's "newest products" carousel: the old 3D coverflow with autoplay, but built as STATIC HTML. Every card is a real
// <a href> with its name and photo in the first response (the old version was a client-only React island: nothing of it existed
// until JavaScript ran). The first paint is already the coverflow (the CSS in shop.css positions each card from its
// data-offset, computed here for the first slide as active), so nothing jumps when the script starts. The script only moves the
// offsets: arrows, drag, horizontal wheel, autoplay (paused on hover/focus/touch, off with prefers-reduced-motion).
import { localizePath } from '../../shared/locales.js';
import { productCustomAlt, productName } from '../../shared/productText.js';
import { productPath } from '../../shared/urls.js';
import { translator } from '../lib/i18n.ts';
import { mediaVariant } from '../lib/media.ts';
import ProductBadgesView from './ProductBadgesView.astro';
import type { Locale } from '../lib/seo/types.ts';

const SLIDE_COUNT = 5;
const { products, locale } = Astro.props as { products: any[]; locale: Locale };
const t = translator(locale);
const slides = products.slice(0, SLIDE_COUNT);
// Same rule as the script: the signed distance of a card from the active one, wrapped to the shortest way round.
const half = Math.floor(slides.length / 2);
const offsetOf = (index: number) => {
  let offset = index;
  while (offset > half) offset -= slides.length;
  while (offset < -half) offset += slides.length;
  return offset;
};
// 450 px cards on a desktop, narrower on a phone (see .coverflow_viewport in shop.css).
const sizes = '(max-width: 480px) 290px, (max-width: 768px) 360px, 450px';
---
{slides.length > 0 && (
  <section class="product_carousel_section coverflow_carousel" aria-label={t('carousel.featured')} data-coverflow>
    <div class="coverflow_viewport">
      <div class="coverflow_stage">
        {slides.map((product, index) => {
          const image = product.collectionImage || product.mainImage;
          const offset = offsetOf(index);
          return (
            <div class={`coverflow_card${offset === 0 ? ' coverflow_card_active' : ''}`} data-offset={offset}>
              <a href={localizePath(productPath(product), locale)} class="coverflow_card_link" draggable="false">
                <ProductBadgesView product={product} locale={locale} />
                <img
                  src={mediaVariant(image, 'card')}
                  srcset={`${mediaVariant(image, 'card')} 600w, ${mediaVariant(image, 'share')} 1200w`}
                  sizes={sizes}
                  alt={productCustomAlt(product, locale) || productName(product, locale)}
                  class="coverflow_card_img"
                  width="450"
                  height="675"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                  draggable="false"
                />
                <div class="coverflow_card_overlay">
                  <h2 class="coverflow_card_title">{productName(product, locale)}</h2>
                  <span class="coverflow_card_cta">{t('hero.discover')}</span>
                </div>
              </a>
            </div>
          );
        })}
      </div>
      {slides.length > 1 && (
        <>
          <button type="button" class="carousel_arrow carousel_arrow_left" data-dir="-1" aria-label={t('carousel.prev')}>❮</button>
          <button type="button" class="carousel_arrow carousel_arrow_right" data-dir="1" aria-label={t('carousel.next')}>❯</button>
        </>
      )}
    </div>
  </section>
)}
<script>
  const AUTO_DELAY = 4500;
  const DRAG_START_THRESHOLD = 10;

  document.querySelectorAll<HTMLElement>('[data-coverflow]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('.coverflow_viewport');
    const stage = root.querySelector<HTMLElement>('.coverflow_stage');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.coverflow_card'));
    if (!viewport || !stage || cards.length < 2) return;

    const count = cards.length;
    const half = Math.floor(count / 2);
    let active = 0;
    let paused = false;
    let resumeTimer = 0;
    let wheelLock = false;
    let justDragged = false;
    const drag = { active: false, dragging: false, startX: 0, pointerId: -1 };

    const render = () => {
      cards.forEach((card, index) => {
        let offset = index - active;
        while (offset > half) offset -= count;
        while (offset < -half) offset += count;
        card.setAttribute('data-offset', String(offset));
        card.classList.toggle('coverflow_card_active', offset === 0);
      });
    };
    const go = (index: number) => {
      active = ((index % count) + count) % count;
      render();
    };

    // After any interaction the autoplay waits one full delay before it resumes (as the old carousel did).
    const pauseFor = () => {
      paused = true;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        paused = false;
      }, AUTO_DELAY);
    };

    root.querySelectorAll<HTMLElement>('[data-dir]').forEach((button) => {
      button.addEventListener('click', () => {
        pauseFor();
        go(active + Number(button.getAttribute('data-dir')));
      });
    });

    // Drag (mouse, touch, pen): the cards follow the pointer through --cf-drag, then it settles on the next or previous one.
    viewport.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || (event.target as HTMLElement).closest('.carousel_arrow')) return;
      drag.active = true;
      drag.dragging = false;
      drag.startX = event.clientX;
      drag.pointerId = event.pointerId;
      paused = true;
      window.clearTimeout(resumeTimer);
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!drag.active || event.pointerId !== drag.pointerId) return;
      const dx = event.clientX - drag.startX;
      if (!drag.dragging) {
        if (Math.abs(dx) < DRAG_START_THRESHOLD) return;
        drag.dragging = true;
        viewport.classList.add('is-dragging');
        viewport.setPointerCapture(event.pointerId);
      }
      viewport.style.setProperty('--cf-drag', `${dx}px`);
    });
    const finishDrag = (event: PointerEvent) => {
      if (!drag.active || event.pointerId !== drag.pointerId) return;
      const dx = event.clientX - drag.startX;
      const wasDragging = drag.dragging;
      drag.active = false;
      drag.dragging = false;
      viewport.classList.remove('is-dragging');
      viewport.style.removeProperty('--cf-drag');
      if (wasDragging) {
        viewport.releasePointerCapture(event.pointerId);
        justDragged = true;
        // The same spacing the CSS uses (--cf-s), so a drag of a quarter of the gap between cards counts.
        const width = viewport.clientWidth;
        const spacing = width <= 480 ? Math.max(90, Math.min(140, width * 0.3)) : width <= 768 ? Math.max(140, Math.min(220, width * 0.28)) : Math.max(195, Math.min(390, width * 0.285));
        const threshold = Math.max(35, spacing * 0.25);
        if (dx < -threshold) go(active + 1);
        else if (dx > threshold) go(active - 1);
      }
      pauseFor();
    };
    viewport.addEventListener('pointerup', finishDrag);
    viewport.addEventListener('pointercancel', finishDrag);
    // A drag that ends on a card must not open it.
    viewport.addEventListener(
      'click',
      (event) => {
        if (!justDragged) return;
        justDragged = false;
        if ((event.target as HTMLElement).closest('a.coverflow_card_link')) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );

    // A horizontal trackpad/wheel gesture moves one card; vertical scrolling is left to the page.
    viewport.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaX) < Math.abs(event.deltaY) * 0.6) return;
        event.preventDefault();
        if (wheelLock) return;
        wheelLock = true;
        paused = true;
        if (event.deltaX > 0) go(active + 1);
        else if (event.deltaX < 0) go(active - 1);
        window.setTimeout(() => {
          wheelLock = false;
          pauseFor();
        }, 700);
      },
      { passive: false },
    );

    // Keyboard: the arrows buttons are normal buttons; focusing anything inside (a card link, an arrow) stops the autoplay.
    root.addEventListener('mouseenter', () => {
      paused = true;
      window.clearTimeout(resumeTimer);
    });
    root.addEventListener('mouseleave', () => {
      window.clearTimeout(resumeTimer);
      paused = false;
    });
    root.addEventListener('focusin', () => {
      paused = true;
      window.clearTimeout(resumeTimer);
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains((event as FocusEvent).relatedTarget as Node | null)) paused = false;
    });

    // Autoplay: never with prefers-reduced-motion, and not while the tab is hidden.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    window.setInterval(() => {
      if (paused || reduced.matches || document.hidden) return;
      go(active + 1);
    }, AUTO_DELAY);

    root.setAttribute('data-ready', '');
  });
</script>
