---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteUrl, mediaBase } from '../../../lib/config';
import CollectionView from '../../../views/CollectionView.astro';
import NotFoundView from '../../../views/NotFoundView.astro';
import { loadCollection } from '../../../lib/pages/load';
import { collectionSeo, errorPageSeo } from '../../../lib/seo/builders.ts';
import { cacheablePage } from '../../../lib/pages/respond';
const locale = 'ar';
const ctx = { siteUrl: siteUrl(), mediaBase: mediaBase() };
const category = Astro.params.category ?? '';
const result = await loadCollection(category);
if (result.kind === 'notfound') Astro.response.status = 404;
if (result.kind === 'unavailable') Astro.response.status = 503;
cacheablePage(Astro.response, result.kind === 'ok');
const seo = result.kind === 'ok' ? collectionSeo(result.data.slug, locale, ctx, result.data.name)
  : errorPageSeo(result.kind === 'unavailable' ? 'unavailable' : 'not-found', locale, ctx, Astro.url.pathname);
---
<BaseLayout locale={locale} seo={seo}>
  {result.kind === 'ok'
    ? <CollectionView slug={result.data.slug} name={result.data.name} products={result.data.products} locale={locale} />
    : <NotFoundView locale={locale} unavailable={result.kind === 'unavailable'} />}
</BaseLayout>
