---
// The page of every unknown address under /ar (see pages/404.astro).
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFoundView from '../../views/NotFoundView.astro';
import { siteUrl, mediaBase } from '../../lib/config';
import { errorPageSeo } from '../../lib/seo/builders.ts';
const locale = 'ar';
const seo = errorPageSeo('not-found', locale, { siteUrl: siteUrl(), mediaBase: mediaBase() }, '/ar');
---
<BaseLayout locale={locale} seo={seo}>
  <NotFoundView locale={locale} />
</BaseLayout>
