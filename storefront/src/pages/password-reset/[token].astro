---
// The one public page rendered on request: its address carries a secret token, so it cannot be a file.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteUrl, mediaBase } from '../../lib/config';
import Island from '../../islands/PasswordResetPage.jsx';
import { privatePageSeo } from '../../lib/seo/builders.ts';
const locale = 'fr';
const ctx = { siteUrl: siteUrl(), mediaBase: mediaBase() };
const seo = privatePageSeo('password-reset-token', locale, ctx, '/password-reset');
const params = { token: Astro.params.token ?? '' };
---
<BaseLayout locale={locale} seo={seo}>
  <Island client:only="react" locale={locale} params={params} />
</BaseLayout>
