---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteUrl, mediaBase } from '../lib/config';
import ContactPage from '../islands/ContactPage.jsx';
import { textPageSeo } from '../lib/seo/builders.ts';
const locale = 'fr';
const ctx = { siteUrl: siteUrl(), mediaBase: mediaBase() };
const seo = textPageSeo('contact', locale, ctx);
---
<BaseLayout locale={locale} seo={seo}>
  <ContactPage client:load locale={locale} />
</BaseLayout>
