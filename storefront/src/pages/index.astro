---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteUrl, mediaBase } from '../lib/config';
import HomeView from '../views/HomeView.astro';
import { loadHome } from '../lib/pages/load';
import { textPageSeo } from '../lib/seo/builders.ts';
import { shareImagePath } from '../lib/pages/respond';
const locale = 'fr';
const ctx = { siteUrl: siteUrl(), mediaBase: mediaBase() };
const { products, theme } = await loadHome();
const seo = textPageSeo('home', locale, ctx, shareImagePath(products));
---
<BaseLayout locale={locale} seo={seo}>
  <HomeView products={products} theme={theme} locale={locale} />
</BaseLayout>
