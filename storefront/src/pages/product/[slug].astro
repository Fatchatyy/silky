---
// Static page, one per published product (generated from the catalogue snapshot at build time). A hidden or unknown product has
// no file here: its address falls through to the Worker's 404 (see src/middleware.ts), where an admin's browser can still open it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteUrl, mediaBase } from '../../lib/config';
import ProductView from '../../views/ProductView.astro';
import { loadProductPage } from '../../lib/pages/load';
import { getSnapshot } from '../../lib/pages/snapshot';
import { productSeo } from '../../lib/seo/builders.ts';

export async function getStaticPaths() {
  return (await getSnapshot()).products.map((product) => ({ params: { slug: product.slug } }));
}

const locale = 'fr';
const ctx = { siteUrl: siteUrl(), mediaBase: mediaBase() };
let loaded;
try {
  loaded = await loadProductPage(Astro.params.slug!);
} catch (error) {
  // astro dev only: the route list was computed when the server started, the data is read again on every request, so a product
  // hidden or deleted since then is a route with no data. Show the real 404 page (an admin's browser opens the editor from it,
  // as on the live site). A build must fail loudly instead, so it rethrows.
  if (!import.meta.env.DEV) throw error;
  return Astro.rewrite('/404');
}
const { product, reviews, rating, deliveryFee, collectionName, recommendations } = loaded;
const seo = productSeo(product, locale, ctx, { rating, deliveryFee, collectionName });
---
<BaseLayout locale={locale} seo={seo}>
  <ProductView product={product} reviews={reviews} rating={rating} collectionName={collectionName} recommendations={recommendations} locale={locale} />
</BaseLayout>
