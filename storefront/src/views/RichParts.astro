---
// A paragraph's parts (see shared/textPages.js): plain text, shop links and e-mail links.
import { localizePath } from '../../shared/locales.js';
import type { Locale } from '../lib/seo/types.ts';

const { parts, locale } = Astro.props as { parts: any[]; locale: Locale };
---
{parts.map((part) =>
  typeof part === 'string' ? part
  : part.mail ? <a href={`mailto:${part.mail}`}>{part.text}</a>
  : <a href={localizePath(part.to, locale)}>{part.text}</a>
)}
