# Copy to .env for local work. Only variables starting with PUBLIC_ reach the browser: never put a secret in one.

# Where the Astro server fetches catalog data (server side only; read at run time from wrangler.jsonc "vars" / .dev.vars).
API_URL=http://localhost:3001
# The API as the browser sees it (cart, checkout, login, reviews). Built into the pages: rebuild after changing it.
PUBLIC_API_URL=http://localhost:3001
# Where uploaded photos and videos are served from (the API locally, the media domain in production).
PUBLIC_MEDIA_URL=http://localhost:3001
# Public address of this site, used for canonical, hreflang, Open Graph, sitemap and JSON-LD URLs.
PUBLIC_SITE_URL=http://localhost:4321
# Where the admin panel (its own app) lives; the storefront only links to it.
PUBLIC_ADMIN_URL=http://localhost:5173/admin
